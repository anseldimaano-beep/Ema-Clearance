# Copy to .env (same folder as docker-compose.yml) and change the values. Never share .env.
SECRET_KEY=put-a-long-random-string-here
REGISTRAR_PASSWORD=choose-a-strong-password
ADMIN_PASSWORD=choose-another-strong-password
# ALLOWED_HOSTS=clearance.yourschool.edu.ph

# Neon (PostgreSQL). Leave empty to keep using the built-in SQLite file.
# Neon console > your project > Connect > copy the connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional
# REQUIRE_DEPT_HEAD=0
# OFFICES_NOT_FOR=dir_preservice:BSBA|BSHM;elpt:BSHM   # office:PROGRAM|PROGRAM;...  (that office skips those programs)
# SMS_API_KEY=your-semaphore-api-key                   # turns on student SMS (semaphore.co)
# SMS_SENDER=EMACLEAR
# REMIND_AFTER_DAYS=3
